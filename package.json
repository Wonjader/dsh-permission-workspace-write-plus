{
  "name": "dsh-permission-workspace-write-plus",
  "version": "1.2.2",
  "private": false,
  "description": "DSH fully-pluggable Workspace Write Plus preset: workspace read/write + config-type files outside the workspace (no same-named workspace counterpart) + .dsh/profiles plugin writes + .dsh/skills writes + OS sleep/shutdown commands + full tool calls + merged cross-platform sleep guard (Windows/Linux/macOS/WSL to Windows host). Everything else outside the workspace stays write-denied. Zero core changes; hot-pluggable via profile patch HMR.",
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.md"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./preset": "./lib/preset.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./shell": "./lib/shell.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./fs": "./lib/fs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wonjader/dsh-permission-workspace-write-plus.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek",
    "harness",
    "permission",
    "workspace",
    "write-plus",
    "sleep-guard"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-pwsh-local": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-fs-local": "*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "homepage": "https://github.com/Wonjader/dsh-permission-workspace-write-plus",
  "bugs": {
    "url": "https://github.com/Wonjader/dsh-permission-workspace-write-plus/issues"
  },
  "author": "Wonjader"
}
